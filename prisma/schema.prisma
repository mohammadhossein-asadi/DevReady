// DevReady Phase 5 — optional accounts + difficulty votes.
// Everything works without an account; these tables only serve the
// opt-in sync (`/api/sync`) and community vote aggregates (`/api/votes`).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Account {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String?
  role         String    @default("user")
  /// scrypt hash in `salt:hash` hex form — never the password itself.
  passwordHash String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sessions     Session[]
  snapshot     Snapshot?
  votes        Vote[]
}

model Session {
  id        String   @id @default(cuid())
  /// SHA-256 of the bearer token — the raw token only ever lives client-side.
  tokenHash String   @unique
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([accountId])
}

/// One cloud snapshot per account: the JSON payload of the five local stores
/// (library, daily, srs, contribs, votes). Merge happens client-side.
model Snapshot {
  accountId String  @id
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  payload   String
  /// Client-reported device label of the last writer (best effort).
  device    String?
  updatedAt DateTime @updatedAt
}

/// Community contribution queue (Phase 7). Signed-in users submit resources;
/// submissions are public-readable and moderated by status.
model Submission {
  id         String   @id @default(cuid())
  accountId  String?
  title      String
  url        String
  categoryId String
  language   String
  kind       String
  level      String?
  desc       String
  author     String?
  status     String   @default("queued")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([status])
  @@index([categoryId])
}

model Vote {
  id        String   @id @default(cuid())
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  key       String
  /// "easy" | "medium" | "hard"
  level     String
  updatedAt DateTime @updatedAt

  @@unique([accountId, key])
  @@index([key])
}
